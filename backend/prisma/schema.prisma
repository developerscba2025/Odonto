generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String            @id @default(uuid())
  name         String
  email        String            @unique
  passwordHash String
  role         String
  color        String?
  appointments   Appointment[]
  clinicalHist   ClinicalHistory[]
  absences       ProfessionalAbsence[]
}

model Patient {
  id             String            @id @default(uuid())
  firstName      String
  lastName       String
  dni            String            @unique
  birthDate      DateTime?
  phone          String?
  email          String?
  obraSocial     String?
  affiliateNum   String?
  isDeleted      Boolean           @default(false)
  createdAt      DateTime          @default(now())
  appointments   Appointment[]
  clinicalHist   ClinicalHistory[]
  odontograms    Odontogram[]
  treatmentPlans TreatmentPlan[]
}

model Appointment {
  id             String   @id @default(uuid())
  patientId      String
  professionalId String
  date           DateTime
  startTime      String
  endTime        String
  status         String
  reason         String?
  notes          String?
  service        String?
  isDeleted      Boolean  @default(false)

  professional   User     @relation(fields: [professionalId], references: [id])
  patient        Patient  @relation(fields: [patientId], references: [id])
}

model Attachment {
  id                String          @id @default(uuid())
  clinicalHistoryId String
  type              String
  url               String
  description       String?
  createdAt         DateTime        @default(now())
  clinicalHistory   ClinicalHistory @relation(fields: [clinicalHistoryId], references: [id])
}

model TreatmentPlan {
  id          String            @id @default(uuid())
  patientId   String
  description String
  budget      Float?
  status      String
  tasks       String?           @default("[]")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  patient     Patient           @relation(fields: [patientId], references: [id])
  histories   ClinicalHistory[]
}

model ClinicalHistory {
  id                String       @id @default(uuid())
  patientId         String
  professionalId    String
  treatmentPlanId   String?
  date              DateTime     @default(now())
  description       String
  attachments       Attachment[]
  professional      User         @relation(fields: [professionalId], references: [id])
  patient           Patient      @relation(fields: [patientId], references: [id])
  treatmentPlan     TreatmentPlan? @relation(fields: [treatmentPlanId], references: [id])
  odontogramEntries Odontogram[]
}

model Odontogram {
  id                String           @id @default(uuid())
  patientId         String
  clinicalHistoryId String?
  toothNumber       Int
  status            String
  notes             String?
  clinicalHistory   ClinicalHistory? @relation(fields: [clinicalHistoryId], references: [id])
  patient           Patient          @relation(fields: [patientId], references: [id])
}

model ClinicSettings {
  id      String   @id @default("singleton")
  name    String   @default("OdontoNexus")
  phone   String?
  address String?
  logoUrl String?
  openTime String @default("08:00")
  closeTime String @default("20:00")
}

model ProfessionalAbsence {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  start     DateTime
  end       DateTime
  reason    String?
  createdAt DateTime @default(now())
}
