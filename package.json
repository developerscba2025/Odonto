{
  "name": "dentalflow-monorepo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "db:push": "pnpm --filter @dentalflow/api exec prisma db push",
    "db:generate": "pnpm --filter @dentalflow/api exec prisma generate",
    "db:seed": "pnpm --filter @dentalflow/api exec node ./dist/seed.js"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
